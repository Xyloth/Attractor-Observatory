# =============================================================================
# Attractor Observatory — public-facing portfolio repository
#
# This repository is a curated public showcase of the project's documentation,
# specifications, doctrine, AI-collaboration framework, methodology, and
# numerical evidence. The full implementation (substrate engines, motif
# detectors, validation gauntlet, kernel) is held privately. Sample code
# excerpts demonstrating technical depth live in docs/SAMPLE_CODE.md.
#
# What ships publicly: README, LICENSE, CITATION, CONTRIBUTING, all spec
# versions, all CODEX_*.md campaign drivers, the doctrine document, the
# methods documents, the substance audits, the truth pass, the decision log,
# the AI builder ledger (empirical estimation calibration data), preregistration
# records, campaign summary reports, the negative-space registry, and curated
# code excerpts in docs/.
#
# What does not ship: the substrate engines (worlds/), motif detectors
# (motifs/), validation gauntlet (validation/), null factory (nulls/), kernel
# (core/), trace plane (trace/), formalism layer (formalism/), biology shadow
# (biology/), search/orchestration (search/), test suite (tests/), atlas
# Python modules, AI OS Python modules, top-level entry points, and per-seed
# trace dumps.
# =============================================================================

# -----------------------------------------------------------------------------
# Implementation modules — held privately
# -----------------------------------------------------------------------------
worlds/
motifs/
validation/
nulls/
core/
trace/
formalism/
biology/
search/
ops/
experiments/
evidence/
tests/

# -----------------------------------------------------------------------------
# Curated public-methodology surface inside otherwise-private formalism layer.
# These specific files ship publicly because they are the methodological
# contributions other researchers need to read to understand the project's
# claims (4-tier substance gate, motif-contract schema and predicates, four-axis
# adversarial controls, D31 read-separation enforcement). Everything else under
# formalism/ stays private.
#
# Rule order is load-bearing: re-allow the parent directory, re-ignore its
# contents, then explicitly un-ignore the curated files.
# -----------------------------------------------------------------------------
!formalism/evidence/
formalism/evidence/*
!formalism/evidence/substance_gate.py

!formalism/motif_contracts/
formalism/motif_contracts/*
!formalism/motif_contracts/adversarial.py
!formalism/motif_contracts/contracts.py
!formalism/motif_contracts/schema.py

!formalism/floor_bfg/
formalism/floor_bfg/*
!formalism/floor_bfg/read_separation.py

# Top-level Python entry points
observatory_cli.py
verify_bundle.py
make_campaign_*.py
make_task_*.py

# AI OS Python (memory ledger Markdown is kept; .py modules are private)
ai_os/*.py
ai_os/__pycache__/
ai_os/debate_log/

# Atlas Python (markdown summaries kept; .py is private)
atlas/db.py
atlas/structured.py
atlas/__pycache__/
atlas/negative_space/structured.py
atlas/negative_space/__pycache__/

# -----------------------------------------------------------------------------
# Runtime artifacts and per-seed trace dumps (regenerable)
# -----------------------------------------------------------------------------
runs/
trace_store/
reports/*/traces/
reports/*/he_traces/
reports/*/w5_traces/
reports/*/closure_recurrence/traces/
reports/*/closure_recurrence_verify/traces/
reports/phase1/closure_recurrence/traces/
reports/phase1/closure_recurrence_verify/traces/
reports/*/source_cache/
reports/*/factory_store/.daemon_lock
reports/*/factory_store/source_cache/
reports/task_cb014_launch/
reports/task_phase_b_verify/
reports/_tmp_adapter_count_check/

# Control Room runtime snapshots/logs. Keep latest_* tracked where already
# tracked; per-run and timestamped snapshots are regenerable runtime output.
control_room/cache/daemon_logs/
control_room/cache/factory_runs/run_*.json
control_room/snapshots/state_2026*.json

